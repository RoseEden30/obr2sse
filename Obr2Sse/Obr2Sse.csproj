<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Obr2Sse</RootNamespace>
    <AssemblyName>obr2sse</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCnEncoder.Net" Version="2.3.0" />
    <PackageReference Include="CCd.MeshDecimator" Version="5.2503.0" />
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="0.54.4" />
    <ProjectReference Include="..\..\CUE4Parse\CUE4Parse\CUE4Parse.csproj" />
    <ProjectReference Include="..\..\CUE4Parse\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
    <PackageReference Include="K4os.Compression.LZ4.Streams" Version="1.3.8" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- Pin past CVE-2026-26127 (Base64Url DoS); pulled in transitively via CUE4Parse's IndexRange. -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="9.0.14" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\native\build\bin\nifwrap.dll" Condition="Exists('..\native\build\bin\nifwrap.dll')">
      <Link>nifwrap.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\tools\texconv.exe" Condition="Exists('..\tools\texconv.exe')">
      <Link>texconv.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
